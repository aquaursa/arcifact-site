{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Arcifact Evidence Certificate",
 "type": "object",
 "required": [
  "subject",
  "release",
  "banks",
  "envelope",
  "stance",
  "fabrication_rate",
  "thresholds",
  "provenance",
  "issued",
  "expires"
 ],
 "properties": {
  "subject": {
   "type": "string"
  },
  "release": {
   "type": "string"
  },
  "banks": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "bank",
     "bank_sha256",
     "score",
     "fabrication_rate",
     "n",
     "raw"
    ]
   }
  },
  "envelope": {
   "type": "string",
   "description": "the declared regime in which results hold"
  },
  "stance": {
   "type": "object",
   "description": "answers / entitled refusals / errors, counted"
  },
  "fabrication_rate": {
   "type": "number"
  },
  "thresholds": {
   "type": "array",
   "description": "preregistered bars with timestamps"
  },
  "provenance": {
   "type": "object",
   "required": [
    "scorer_commit",
    "manifest_root"
   ]
  },
  "issued": {
   "type": "string"
  },
  "expires": {
   "type": "string",
   "description": "renewal due at next release or 12 months"
  },
  "revocation": {
   "type": "string",
   "description": "URL checked by verifiers"
  }
 }
}